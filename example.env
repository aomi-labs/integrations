# Shadow public testnet (chain 5042002). Addresses from
# vendor/shadow/docs/SELF_SERVICE_TESTNET.md and its deployment manifest.
ARC_RPC_URL=https://rpc.testnet.arc.io
FLOAT_MAINNET_EXPECTED_CHAIN_ID=5042002
FLOAT_MANIFEST=vendor/shadow/contracts/deployments/public-testnet/arc-testnet.manifest.json
PROVIDER_ADMISSION_MODE=testnet-unmonitored

# This provider. The endpoint string is what the sponsor approves on the line
# (hashed as endpointHash); the price is the fixed principal in micro-USDC.
FLOAT_PROVIDER_PRIVATE_KEY=
PROVIDER_ENDPOINT=https://YOUR_HOST/aomi-task/v1/build
PROVIDER_PRICE=10000
PROVIDER_STORE_DIR=/var/lib/aomi-task-shadow
PROVIDER_PUBLIC_ORIGIN=
PORT=8080
HOST=127.0.0.1

# Aomi Task API. The payer needs a funded Circle Gateway deposit on the chain;
# the JWKS file is provisioned out of band, never taken from a quote.
AOMI_TASK_ENDPOINT=https://api-staging.aomi.dev/v1/task/build
AOMI_TASK_RECIPIENT=
AOMI_TASK_PAYER_PRIVATE_KEY=
AOMI_TASK_TRUSTED_JWKS_FILE=./trusted-jwks.json
# 0 sells zero-outflow tasks only (retrieval free, total 0.01 USDC). To sell
# tasks that move USDC, raise both together: the retrieval fee is 3% of the
# outflow cap, and PROVIDER_PRICE must cover 10000 + that fee.
AOMI_TASK_MAX_OUTGOING_USDC_WEI=0
AOMI_TASK_MAX_RETRIEVAL_FEE_MICROUSD=0
AOMI_TASK_WAIT_MS=90000
